{
  "name": "sv-unterigling",
  "description": "Website des Schützenverein Unterigling e.V. mit Vorstands- und Helferbereich",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:emu": "astro dev --mode emulator",
    "build": "astro build",
    "build:emu": "astro build --mode emulator",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --project demo-sv-unterigling --only auth,firestore,storage",
    "emulators:seed": "node scripts/seed-emulator.mjs",
    "format": "prettier --write .",
    "astro": "astro",
    "test:rules": "node scripts/test-rules.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.55.0",
    "astro": "^7.3.8",
    "firebase": "^13.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
