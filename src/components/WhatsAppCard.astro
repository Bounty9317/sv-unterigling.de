---
import QRCode from 'qrcode';
import { MessageCircle } from '@lucide/astro';
import { verein } from '../data/verein';

// QR-Code wird beim Bauen der Seite erzeugt – kein externer Dienst, keine Datenweitergabe.
const qrSvg = await QRCode.toString(verein.whatsappKanal, {
  type: 'svg',
  margin: 1,
  errorCorrectionLevel: 'M',
  color: { dark: '#12301fff', light: '#ffffffff' },
});
---

<a class="wa-card" href={verein.whatsappKanal} target="_blank" rel="noopener">
  <span class="wa-card__qr" aria-hidden="true" set:html={qrSvg} />
  <span class="wa-card__text">
    <span class="wa-card__title"><MessageCircle aria-hidden="true" /> WhatsApp-Kanal</span>
    <span>Ihr wollt kein Event verpassen? Dann folgt unserem WhatsApp Kanal!</span>
  </span>
</a>

<style>
  .wa-card {
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background: var(--c-brand-dark);
    color: var(--c-on-brand-muted);
    text-decoration: none;
    text-align: center;
    box-shadow: var(--shadow-m);
    transition:
      transform var(--duration) var(--ease-out),
      box-shadow var(--duration) ease;
  }

  .wa-card:hover {
    color: var(--c-on-brand-muted);
    transform: translateY(-2px);
    box-shadow: var(--shadow-l);
  }

  .wa-card__qr {
    display: block;
    width: 9.5rem;
    padding: 0.5rem;
    border-radius: var(--radius-m);
    background: #fff;
  }

  .wa-card__qr :global(svg) {
    width: 100%;
    height: auto;
  }

  .wa-card__text {
    display: grid;
    gap: 0.35rem;
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .wa-card__title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: var(--step-0);
    color: #7ee2a0;
  }

  .wa-card__title :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
