---
import { Image } from 'astro:assets';
import tree from '../assets/images/christbaum.png';
---

<div class="winter" data-winter hidden aria-hidden="true">
  <canvas class="winter__snow" data-snow></canvas>
  <Image src={tree} alt="" width={360} height={360} class="winter__tree winter__tree--left" loading="lazy" />
  <Image src={tree} alt="" width={360} height={360} class="winter__tree winter__tree--right" loading="lazy" />
</div>

<style>
  .winter {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
  }

  .winter__snow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Christbäume nur, wenn neben dem Inhalt Platz ist – sie sollen nichts verdecken */
  .winter__tree {
    position: absolute;
    bottom: 0;
    width: clamp(120px, calc((100vw - 84rem) / 2 - 12px), 280px);
    height: auto;
    filter: drop-shadow(5px 5px 15px rgb(0 0 0 / 0.5));
    opacity: 0.95;
  }

  .winter__tree--left {
    left: 0;
  }

  .winter__tree--right {
    right: 0;
    transform: scaleX(-1);
  }

  @media (max-width: 1680px) {
    .winter__tree {
      display: none;
    }
  }

  :global(.xmas-light) {
    position: absolute;
    width: 9px;
    height: 13px;
    border-radius: 50% 50% 40% 40%;
    animation: light-blink 1.5s infinite;
  }

  :global(.xmas-light)::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    width: 3px;
    height: 6px;
    translate: -50% 0;
    background: #1b1b1b;
    border-radius: 1px;
  }

  @keyframes light-blink {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 10px 2px currentColor;
    }
    50% {
      opacity: 0.35;
      box-shadow: none;
    }
  }
</style>

<script>
  import { initWinterMode } from '../scripts/winter';
  initWinterMode();
</script>
