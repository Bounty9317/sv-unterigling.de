---
import { Moon, Sun } from '@lucide/astro';
import { oeffnungszeiten } from '../data/verein';
---

<div class="hours reveal-stagger">
  <article class="hours__tile">
    <h3><Moon aria-hidden="true" /> {oeffnungszeiten.samstag.titel}</h3>
    <p class="hours__main"><strong>{oeffnungszeiten.samstag.zeitraum}</strong></p>
    <p class="hours__main">{oeffnungszeiten.samstag.zeiten}</p>
    <p class="hours__note">({oeffnungszeiten.samstag.hinweis})</p>
  </article>
  <article class="hours__tile">
    <h3><Sun aria-hidden="true" /> {oeffnungszeiten.sonntag.titel}</h3>
    <p class="hours__main"><strong>{oeffnungszeiten.sonntag.bezeichnung}</strong></p>
    <p class="hours__main">{oeffnungszeiten.sonntag.zeiten}</p>
    <p class="hours__note">{oeffnungszeiten.sonntag.hinweis}</p>
  </article>
</div>

<style>
  .hours {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m);
  }

  .hours__tile {
    position: relative;
    display: grid;
    gap: 0.3rem;
    padding: var(--space-m) var(--space-m) var(--space-m) calc(var(--space-m) + 4px);
    border-radius: var(--radius-l);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }

  .hours__tile::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: linear-gradient(var(--c-primary), var(--c-accent-strong));
  }

  .hours__tile h3 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.4rem;
    font-size: var(--step-2);
    color: var(--c-primary);
  }

  .hours__tile h3 :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--c-accent);
  }

  .hours__main {
    font-size: var(--step-1);
  }

  .hours__note {
    color: var(--c-text-muted);
    font-size: var(--step--1);
  }
</style>
