---
import { ExternalLink, MapPin } from '@lucide/astro';
import { verein } from '../data/verein';
---

<div class="map" data-map data-src={verein.googleMapsEmbed}>
  <div class="map__placeholder" data-map-placeholder>
    <MapPin aria-hidden="true" class="map__pin" />
    <p class="map__title">Karte von Google Maps</p>
    <p class="map__text">
      Beim Laden der Karte werden Daten (u. a. Ihre IP-Adresse) an Google übertragen. Mehr dazu in der
      <a href="/datenschutz#google-maps">Datenschutzerklärung</a>.
    </p>
    <div class="map__actions">
      <button type="button" class="btn btn--primary" data-map-load>Karte laden</button>
      <label class="check map__remember">
        <input type="checkbox" data-map-remember />
        <span>Karten künftig automatisch laden</span>
      </label>
    </div>
  </div>
</div>
<p class="map__link">
  <a href={verein.googleMapsLink} target="_blank" rel="noopener">
    In Google Maps öffnen <ExternalLink aria-hidden="true" />
  </a>
</p>

<style>
  .map {
    position: relative;
    /* feste Breite: sonst macht die Mindesthöhe über das Seitenverhältnis die Karte auf dem Handy breiter als den Bildschirm */
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: 18rem;
    border-radius: var(--radius-l);
    overflow: hidden;
    border: 1px solid var(--c-border);
    background:
      repeating-linear-gradient(45deg, transparent 0 22px, color-mix(in oklab, var(--c-primary) 6%, transparent) 22px 23px),
      var(--c-surface-2);
  }

  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    padding: var(--space-m);
    text-align: center;
  }

  .map__placeholder :global(.map__pin) {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--c-primary);
  }

  .map__title {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .map__text {
    max-width: 26rem;
    font-size: var(--step--1);
    color: var(--c-text-muted);
  }

  .map__actions {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .map__remember {
    font-size: var(--step--1);
    color: var(--c-text-muted);
  }

  .map__link {
    margin-top: var(--space-s);
    text-align: center;
  }

  .map__link a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
  }

  .map__link :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>

<script>
  import { initMaps } from '../scripts/map-consent';
  initMaps();
</script>
