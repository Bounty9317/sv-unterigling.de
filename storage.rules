rules_version = '2';

// Firebase Storage: nur die Sitzungsprotokolle (PDF) des Vorstands.
service firebase.storage {
  match /b/{bucket}/o {
    // Vorstand: "admin"-Claim oder das Vereinskonto (Login "VorstandLamm") – wie in firestore.rules
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.get('admin', false) == true
          || request.auth.token.email == 'schuetzenvereinunterigling@gmail.com');
    }

    match /protocols/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
