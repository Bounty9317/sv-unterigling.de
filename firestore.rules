rules_version = '2';

// Regeln für die Datenbank "vorstandschaftschuetzen" (siehe firebase.json).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Helfer melden sich mit Benutzernamen an – intern …@helfer.schuetzenverein.local
    function isHelper() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@helfer[.]schuetzenverein[.]local$');
    }

    // Vorstand = Konto mit "admin"-Claim (Vergabe siehe README) oder das Vereinskonto
    // (Login "VorstandLamm"). Ein beliebiges registriertes Konto reicht ausdrücklich NICHT aus.
    function isAdmin() {
      return signedIn()
        && (request.auth.token.get('admin', false) == true
          || request.auth.token.email == 'schuetzenvereinunterigling@gmail.com');
    }

    function isTeam() {
      return isHelper() || isAdmin();
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ältere Tauschanfragen speichern den Dienst im Datum, z. B. "2026-01-10-schiessabend"
    function isDateKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}(-[a-z]+)?$');
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    // ---------- Öffentlich ----------

    match /events/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    function validEvent(d) {
      return shortString(d.title, 200) && d.title.size() > 0
        && isDate(d.date)
        && (!('time' in d) || shortString(d.time, 5))
        && (!('description' in d) || shortString(d.description, 2000))
        && (!('registrationRequired' in d) || d.registrationRequired is bool)
        && (!('cancelled' in d) || d.cancelled is bool);
    }

    // Besucherzähler: jeder darf genau um 1 erhöhen
    match /settings/visitor-counter {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // Wintermodus, veröffentlichte Schießtermine usw.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId != 'visitor-counter';
    }

    // ---------- Nur Vorstand ----------

    match /protocols/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- Helfereinteilung (Vorstand schreibt, Helfer lesen) ----------

    function validPerson(d) {
      return shortString(d.name, 100) && d.name.size() > 0 && shortString(d.color, 20);
    }

    match /wirte-persons/{id} {
      allow read: if isTeam();
      allow create, update: if isAdmin() && validPerson(request.resource.data);
      allow delete: if isAdmin();
    }

    match /aufsicht-persons/{id} {
      allow read: if isTeam();
      allow create, update: if isAdmin() && validPerson(request.resource.data);
      allow delete: if isAdmin();
    }

    function validAssignment(d) {
      return isDate(d.date)
        && shortString(d.person, 100) && d.person.size() > 0
        && shortString(d.color, 20)
        && (!('slot' in d) || d.slot == null || d.slot in ['fruehschoppen', 'schiessabend', 'default']);
    }

    // Helfer dürfen nur einen Tausch eintragen (Person/Farbe/Tauschinfo), sonst nichts.
    function helperSwapUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['person', 'color', 'originalPerson', 'swappedWith'])
        && shortString(request.resource.data.person, 100) && request.resource.data.person.size() > 0
        && shortString(request.resource.data.color, 20);
    }

    match /wirte-assignments/{id} {
      allow read: if isTeam();
      allow create: if isAdmin() && validAssignment(request.resource.data);
      allow update: if (isAdmin() && validAssignment(request.resource.data)) || (isHelper() && helperSwapUpdate());
      allow delete: if isAdmin();
    }

    match /aufsicht-assignments/{id} {
      allow read: if isTeam();
      allow create: if isAdmin() && validAssignment(request.resource.data);
      allow update: if (isAdmin() && validAssignment(request.resource.data)) || (isHelper() && helperSwapUpdate());
      allow delete: if isAdmin();
    }

    function validNote(d) {
      return isDate(d.date) && shortString(d.note, 500);
    }

    match /wirte-notes/{id} {
      allow read: if isTeam();
      allow create, update: if isAdmin() && validNote(request.resource.data);
      allow delete: if isAdmin();
    }

    match /aufsicht-notes/{id} {
      allow read: if isTeam();
      allow create, update: if isAdmin() && validNote(request.resource.data);
      allow delete: if isAdmin();
    }

    match /wirte-days/{id} {
      allow read: if isTeam();
      allow create, update: if isAdmin() && isDate(request.resource.data.date)
        && (!('description' in request.resource.data) || shortString(request.resource.data.description, 200));
      allow delete: if isAdmin();
    }

    // ---------- Tauschanfragen (Helfer und Vorstand) ----------

    function validSwap(d) {
      return shortString(d.requestPerson, 100) && d.requestPerson.size() > 0
        && isDateKey(d.date)
        && d.status in ['pending', 'completed']
        && (!('replacementPerson' in d) || d.replacementPerson == null || shortString(d.replacementPerson, 100));
    }

    match /wirte-swaps/{id} {
      allow read: if isTeam();
      allow create: if isTeam() && validSwap(request.resource.data) && request.resource.data.status == 'pending';
      allow update: if isTeam() && validSwap(request.resource.data);
      allow delete: if isTeam();
    }

    match /aufsicht-swaps/{id} {
      allow read: if isTeam();
      allow create: if isTeam() && validSwap(request.resource.data) && request.resource.data.status == 'pending';
      allow update: if isTeam() && validSwap(request.resource.data);
      allow delete: if isTeam();
    }

    // Alles andere ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
